#!/usr/bin/env bash
# build/mm-geolite2-asn — cross-compile the mm-geolite2-asn generator
# (linux/amd64, version stamped) and produce a self-contained install package,
# then optionally scp it to a host and run the installer over ssh.
#
#   build/mm-geolite2-asn [--cli|--generator] [--key KEY] [user@host]
#
# Modes:
#   --cli (default)  binary only, no systemd units; run it by hand with
#                    -license or $MAXMIND_LICENSE_KEY. No key needed at build.
#   --generator      binary + oneshot service + weekly timer that regenerates
#                    /var/lib/cidr/geolite2-asn.cidr. REQUIRES --key: MaxMind
#                    downloads need a license key, so a generator cannot be built
#                    without one.
#
# The key is written to a mode-600 EnvironmentFile (/etc/cidr/mm-geolite2-asn.env)
# that the service reads — it never appears in the unit file or the process
# arguments. With no host the package is left under build/install/; with a host
# it is scp'd over and installed via ssh.
set -eu

# ---- options: mode + key (order-independent, before the host) ----------------
MODE=cli
KEY=""
while [ $# -gt 0 ]; do
    case "$1" in
        --cli)       MODE=cli;       shift ;;
        --generator) MODE=generator; shift ;;
        --key)       [ $# -ge 2 ] || { echo "build/mm-geolite2-asn: --key needs a value" >&2; exit 2; }
                     KEY=$2; shift 2 ;;
        --key=*)     KEY=${1#--key=}; shift ;;
        --*)         echo "build/mm-geolite2-asn: unknown option $1" >&2; exit 2 ;;
        *)           break ;;
    esac
done

# ---- tool configuration ------------------------------------------------------
BINARY=mm-geolite2-asn
CMD=./cmd/mm-geolite2-asn
DESC="MaxMind GeoLite2 ASN cidr generator"
STAGEDIR=/var/lib/cidr
OUTFILE=geolite2-asn.cidr
GENARGS="-family both"            # key comes from the EnvironmentFile, not here
TIMER="Wed *-*-* 03:20:00 UTC"    # weekly (MaxMind updates GeoLite2 Tue/Fri)
ENVDIR=/etc/cidr
ENVBASE=$BINARY.env               # EnvironmentFile basename

# refuse to build a scheduled generator without a license key
if [ "$MODE" = generator ] && [ -z "$KEY" ]; then
    echo "build/mm-geolite2-asn: --generator requires --key <MAXMIND_LICENSE_KEY>" >&2
    echo "  MaxMind downloads are authenticated; refusing to build a generator" >&2
    echo "  with no key. Get a free key at maxmind.com, then:" >&2
    echo "    build/mm-geolite2-asn --generator --key YOUR_KEY [user@host]" >&2
    exit 1
fi

# ---- common ------------------------------------------------------------------
BIN=/usr/local/bin
SYSTEMD=/etc/systemd/system
ROOT=$(cd "$(dirname "$0")/.." && pwd)
cd "$ROOT"

SERVICE=$BINARY.service
TIMERUNIT=$BINARY.timer
INSTALLER=$BINARY.sh
PACKAGE=$BINARY.tgz

HOST=${1:-}
if [ -z "$HOST" ] && [ -e build/host ]; then
    HOST=$(cat build/host)
fi

BUILD=$ROOT/build
INSTALL=$BUILD/install
rm -rf "$INSTALL"
mkdir -p "$INSTALL"

# ---- version -----------------------------------------------------------------
VERSION=$(git describe --tags --always --dirty 2>/dev/null || echo dev)
REVISION=$(git rev-parse --short=12 HEAD 2>/dev/null || echo none)
echo "VERSION  $VERSION $REVISION"
echo "MODE     $MODE"
echo "BUILD    $BINARY -> linux/amd64"
GOWORK=off GOOS=linux GOARCH=amd64 go build -trimpath \
    -ldflags "-X 'main.Version=$VERSION' -X 'main.Revision=$REVISION'" \
    -o "$INSTALL/$BINARY" "$CMD"

FILES=$BINARY

# ---- systemd units + key EnvironmentFile (generator only) --------------------
if [ "$MODE" = generator ]; then
    echo "CREATE   $ENVBASE (mode 600, holds the license key)"
    umask 077
    cat > "$INSTALL/$ENVBASE" << EOF
# MaxMind license key for $BINARY — installed by build/mm-geolite2-asn.
# Keep this file mode 600; the service reads it as an EnvironmentFile.
MAXMIND_LICENSE_KEY=$KEY
EOF
    umask 022

    echo "CREATE   $SERVICE (oneshot)"
    cat > "$INSTALL/$SERVICE" << EOF
[Unit]
Description=$DESC
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=$ENVDIR/$ENVBASE
ExecStart=$BIN/$BINARY $GENARGS -o $STAGEDIR/$OUTFILE
KillSignal=SIGINT
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
EOF

    echo "CREATE   $TIMERUNIT ($TIMER)"
    cat > "$INSTALL/$TIMERUNIT" << EOF
[Unit]
Description=$DESC timer

[Timer]
OnCalendar=$TIMER
AccuracySec=6h
RandomizedDelaySec=3600s
Persistent=true
Unit=$SERVICE

[Install]
WantedBy=timers.target
EOF
    FILES="$FILES $SERVICE $TIMERUNIT $ENVBASE"
fi

# ---- installer (runs on the target as root) ----------------------------------
echo "BUILD    $INSTALLER"
{
cat << EOF_HEAD
#!/bin/sh
# generated by build/mm-geolite2-asn — installs $BINARY ($MODE)
set -eu
BINARY=$BINARY
MODE=$MODE
SERVICE=$SERVICE
TIMER=$TIMERUNIT
PACKAGE=$PACKAGE
BIN=$BIN
SYSTEMD=$SYSTEMD
STAGEDIR=$STAGEDIR
ENVDIR=$ENVDIR
ENVBASE=$ENVBASE
EOF_HEAD
cat << 'EOF_BODY'
[ "$(id -u)" = 0 ] || { echo "installer: run as root (sudo ./$BINARY.sh)"; exit 1; }
echo "installer: $BINARY ($MODE) starting"
tar -xzf "$PACKAGE"

install -m 0755 "$BINARY" "$BIN/$BINARY"
echo "install: binary -> $BIN/$BINARY"

if [ "$MODE" = generator ]; then
    mkdir -p "$STAGEDIR" "$ENVDIR"
    install -m 0600 "$ENVBASE" "$ENVDIR/$ENVBASE"
    echo "install: license key -> $ENVDIR/$ENVBASE (mode 600)"
    systemctl stop "$TIMER" 2>/dev/null || true
    install -m 0644 "$SERVICE" "$SYSTEMD/$SERVICE"
    install -m 0644 "$TIMER"   "$SYSTEMD/$TIMER"
    systemctl daemon-reload
    systemctl enable --now "$TIMER"
    echo "install: timer enabled -> $TIMER"
    echo "install: run now with -> sudo systemctl start $SERVICE"
fi

rm -f "$PACKAGE" "$BINARY.sh" "$ENVBASE" 2>/dev/null || true
echo "install: complete"
EOF_BODY
} > "$INSTALL/$INSTALLER"
chmod +x "$INSTALL/$INSTALLER"

# ---- package -----------------------------------------------------------------
echo "BUILD    $PACKAGE"
tar -czf "$BUILD/$PACKAGE" -C "$INSTALL" $FILES
mv "$BUILD/$PACKAGE" "$INSTALL/$PACKAGE"

# ---- transmit ----------------------------------------------------------------
if [ -n "$HOST" ]; then
    echo "TRANSMIT $PACKAGE + $INSTALLER -> $HOST"
    scp "$INSTALL/$PACKAGE" "$INSTALL/$INSTALLER" "$HOST:"
    echo "RUN      $HOST: sudo ./$INSTALLER"
    ssh "$HOST" "sudo ./$INSTALLER"
    echo "CLEANUP  $INSTALL"
    rm -rf "$INSTALL"
else
    echo "PACKAGE  $INSTALL/$PACKAGE"
    echo "         (no host — scp $PACKAGE + $INSTALLER to a server and run sudo ./$INSTALLER)"
    echo "         NOTE: $INSTALL/$ENVBASE holds the license key; it is gitignored."
fi
echo "bye"
