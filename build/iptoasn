#!/usr/bin/env bash
# build/iptoasn — cross-compile the iptoasn generator (linux/amd64, version
# stamped) and produce a self-contained install package, then optionally scp it
# to a host and run the installer over ssh.
#
#   build/iptoasn [--cli|--generator] [user@host]
#
# Modes (kept distinct from the host arg so a hostname is never mistaken for a
# mode):
#   --cli (default)  binary only, no systemd units; run it by hand. Safe for
#                    anyone who pulls the repo (nothing is auto-scheduled).
#   --generator      binary + oneshot service + daily timer that regenerates
#                    /var/lib/cidr/ip2asn.cidr. Deploy to the host that owns the
#                    generated resource.
#
# With no host the package is left under build/install/; with a host (positional
# or the build/host file) the package + installer are scp'd over and run via ssh.
set -eu

# ---- mode --------------------------------------------------------------------
MODE=cli
case "${1:-}" in
    --cli)       MODE=cli;       shift ;;
    --generator) MODE=generator; shift ;;
esac

# ---- tool configuration ------------------------------------------------------
BINARY=iptoasn
CMD=./cmd/iptoasn
DESC="iptoasn IP-to-ASN cidr generator"
STAGEDIR=/var/lib/cidr            # generated output directory
OUTFILE=ip2asn.cidr               # generated file (STAGEDIR/OUTFILE)
GENARGS="-family combined"        # generator switches
TIMER="*-*-* 02:20:00 UTC"        # daily (iptoasn refreshes often)

# ---- common ------------------------------------------------------------------
BIN=/usr/local/bin
SYSTEMD=/etc/systemd/system
ROOT=$(cd "$(dirname "$0")/.." && pwd)
cd "$ROOT"

SERVICE=$BINARY.service
TIMERUNIT=$BINARY.timer
INSTALLER=$BINARY.sh
PACKAGE=$BINARY.tgz

HOST=${1:-}
if [ -z "$HOST" ] && [ -e build/host ]; then
    HOST=$(cat build/host)
fi

BUILD=$ROOT/build
INSTALL=$BUILD/install
rm -rf "$INSTALL"
mkdir -p "$INSTALL"

# ---- version -----------------------------------------------------------------
VERSION=$(git describe --tags --always --dirty 2>/dev/null || echo dev)
REVISION=$(git rev-parse --short=12 HEAD 2>/dev/null || echo none)
echo "VERSION  $VERSION $REVISION"
echo "MODE     $MODE"
echo "BUILD    $BINARY -> linux/amd64"
GOWORK=off GOOS=linux GOARCH=amd64 go build -trimpath \
    -ldflags "-X 'main.Version=$VERSION' -X 'main.Revision=$REVISION'" \
    -o "$INSTALL/$BINARY" "$CMD"

FILES=$BINARY

# ---- systemd units (generator only) ------------------------------------------
if [ "$MODE" = generator ]; then
    echo "CREATE   $SERVICE (oneshot)"
    cat > "$INSTALL/$SERVICE" << EOF
[Unit]
Description=$DESC
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=$BIN/$BINARY $GENARGS -o $STAGEDIR/$OUTFILE
KillSignal=SIGINT
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
EOF

    echo "CREATE   $TIMERUNIT ($TIMER)"
    cat > "$INSTALL/$TIMERUNIT" << EOF
[Unit]
Description=$DESC timer

[Timer]
OnCalendar=$TIMER
AccuracySec=1h
RandomizedDelaySec=600s
Persistent=true
Unit=$SERVICE

[Install]
WantedBy=timers.target
EOF
    FILES="$FILES $SERVICE $TIMERUNIT"
fi

# ---- installer (runs on the target as root) ----------------------------------
echo "BUILD    $INSTALLER"
{
cat << EOF_HEAD
#!/bin/sh
# generated by build/iptoasn — installs $BINARY ($MODE)
set -eu
BINARY=$BINARY
MODE=$MODE
SERVICE=$SERVICE
TIMER=$TIMERUNIT
PACKAGE=$PACKAGE
BIN=$BIN
SYSTEMD=$SYSTEMD
STAGEDIR=$STAGEDIR
EOF_HEAD
cat << 'EOF_BODY'
[ "$(id -u)" = 0 ] || { echo "installer: run as root (sudo ./$BINARY.sh)"; exit 1; }
echo "installer: $BINARY ($MODE) starting"
tar -xzf "$PACKAGE"

install -m 0755 "$BINARY" "$BIN/$BINARY"
echo "install: binary -> $BIN/$BINARY"

if [ "$MODE" = generator ]; then
    mkdir -p "$STAGEDIR"
    systemctl stop "$TIMER" 2>/dev/null || true
    install -m 0644 "$SERVICE" "$SYSTEMD/$SERVICE"
    install -m 0644 "$TIMER"   "$SYSTEMD/$TIMER"
    systemctl daemon-reload
    systemctl enable --now "$TIMER"
    echo "install: timer enabled -> $TIMER"
    echo "install: run now with -> sudo systemctl start $SERVICE"
fi

rm -f "$PACKAGE" "$BINARY.sh"
echo "install: complete"
EOF_BODY
} > "$INSTALL/$INSTALLER"
chmod +x "$INSTALL/$INSTALLER"

# ---- package -----------------------------------------------------------------
echo "BUILD    $PACKAGE"
tar -czf "$BUILD/$PACKAGE" -C "$INSTALL" $FILES
mv "$BUILD/$PACKAGE" "$INSTALL/$PACKAGE"

# ---- transmit ----------------------------------------------------------------
if [ -n "$HOST" ]; then
    echo "TRANSMIT $PACKAGE + $INSTALLER -> $HOST"
    scp "$INSTALL/$PACKAGE" "$INSTALL/$INSTALLER" "$HOST:"
    echo "RUN      $HOST: sudo ./$INSTALLER"
    ssh "$HOST" "sudo ./$INSTALLER"
    echo "CLEANUP  $INSTALL"
    rm -rf "$INSTALL"
else
    echo "PACKAGE  $INSTALL/$PACKAGE"
    echo "         (no host — scp $PACKAGE + $INSTALLER to a server and run sudo ./$INSTALLER)"
fi
echo "bye"
