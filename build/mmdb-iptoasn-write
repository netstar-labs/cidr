#!/usr/bin/env bash
# build/mmdb-iptoasn-write — cross-compile the mmdb-write tool (linux/amd64,
# version stamped) and produce a self-contained install package, then optionally
# scp it to a host and run the installer over ssh.
#
#   build/mmdb-iptoasn-write [--cli|--generator] [user@host]
#
# Modes:
#   --cli (default)  binary only; pipe cidr spec data to it on stdin.
#   --generator      binary + oneshot service + daily timer that fetches
#                    iptoasn.com data and compiles it into IP and Country MMDB files.
set -eu

MODE=cli
while [ $# -gt 0 ]; do
    case "$1" in
        --cli)       MODE=cli;       shift ;;
        --generator) MODE=generator; shift ;;
        --*)         echo "build/mmdb-iptoasn-write: unknown option $1" >&2; exit 2 ;;
        *)           break ;;
    esac
done

# ---- tool configuration ------------------------------------------------------
BINARY=mmdb-write
CMD=./cmd/mmdb-write
DESC="iptoasn MMDB generator — fetches iptoasn.com -> IP + Country MMDBs"
STAGEDIR=/var/lib/cidr
ASN_OUTFILE=iptoasn-asn.mmdb
COUNTRY_OUTFILE=iptoasn-country.mmdb
TIMER="*-*-* 02:30:00 UTC"        # daily, shortly after iptoasn refreshes
# also build the iptoasn binary for the pipeline
PIPE_BINARY=iptoasn
PIPE_CMD=./cmd/iptoasn

# ---- common ------------------------------------------------------------------
BIN=/usr/local/bin
SYSTEMD=/etc/systemd/system
ROOT=$(cd "$(dirname "$0")/.." && pwd)
cd "$ROOT"

SERVICE=$BINARY.service
TIMERUNIT=$BINARY.timer
INSTALLER=$BINARY.sh
PACKAGE=$BINARY.tgz

HOST=${1:-}
if [ -z "$HOST" ] && [ -e build/host ]; then
    HOST=$(cat build/host)
fi

BUILD=$ROOT/build
INSTALL=$BUILD/install
rm -rf "$INSTALL"
mkdir -p "$INSTALL"

# ---- version -----------------------------------------------------------------
VERSION=$(git describe --tags --always --dirty 2>/dev/null || echo dev)
REVISION=$(git rev-parse --short=12 HEAD 2>/dev/null || echo none)
echo "VERSION  $VERSION $REVISION"
echo "MODE     $MODE"
echo "BUILD    $BINARY -> linux/amd64"
(cd cmd/mmdb-write && GOWORK=off GOOS=linux GOARCH=amd64 go build -trimpath \
    -ldflags "-X 'main.Version=$VERSION' -X 'main.Revision=$REVISION'" \
    -o "$INSTALL/$BINARY" .)

FILES=$BINARY

if [ "$MODE" = generator ]; then
    echo "BUILD    $PIPE_BINARY -> linux/amd64"
    GOWORK=off GOOS=linux GOARCH=amd64 go build -trimpath \
        -ldflags "-X 'main.Version=$VERSION' -X 'main.Revision=$REVISION'" \
        -o "$INSTALL/$PIPE_BINARY" "$PIPE_CMD"
    FILES="$FILES $PIPE_BINARY"
fi

# ---- systemd units (generator only) ------------------------------------------
if [ "$MODE" = generator ]; then
    echo "CREATE   $SERVICE (oneshot)"
    cat > "$INSTALL/$SERVICE" << EOF
[Unit]
Description=$DESC
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/bin/sh -c '$BIN/$PIPE_BINARY -family combined | $BIN/$BINARY -description "iptoasn.com ASN" -o $STAGEDIR/$ASN_OUTFILE'
ExecStart=/bin/sh -c '$BIN/$PIPE_BINARY -family combined -output country | $BIN/$BINARY -description "iptoasn.com Country" -db-type GeoLite2-Country -o $STAGEDIR/$COUNTRY_OUTFILE'
KillSignal=SIGINT
TimeoutStopSec=120

[Install]
WantedBy=multi-user.target
EOF

    echo "CREATE   $TIMERUNIT ($TIMER)"
    cat > "$INSTALL/$TIMERUNIT" << EOF
[Unit]
Description=$DESC timer

[Timer]
OnCalendar=$TIMER
AccuracySec=1h
RandomizedDelaySec=600s
Persistent=true
Unit=$SERVICE

[Install]
WantedBy=timers.target
EOF
    FILES="$FILES $SERVICE $TIMERUNIT"
fi

# ---- installer (runs on the target as root) ----------------------------------
echo "BUILD    $INSTALLER"
{
cat << EOF_HEAD
#!/bin/sh
# generated by build/mmdb-iptoasn-write — installs   ($MODE)
set -eu
BINARY=$BINARY
MODE=$MODE
SERVICE=$SERVICE
TIMER=$TIMERUNIT
PACKAGE=$PACKAGE
BIN=$BIN
SYSTEMD=$SYSTEMD
STAGEDIR=$STAGEDIR
PIPE_BINARY=$PIPE_BINARY
EOF_HEAD

if [ "$MODE" = generator ]; then
    echo "PIPE_BINARY=$PIPE_BINARY" >> "$INSTALL/$INSTALLER"
fi
cat << 'EOF_BODY'
[ "$(id -u)" = 0 ] || { echo "installer: run as root (sudo ./$BINARY.sh)"; exit 1; }
echo "installer: $BINARY ($MODE) starting"
tar -xzf "$PACKAGE"

install -m 0755 "$BINARY" "$BIN/$BINARY"
echo "install: binary -> $BIN/$BINARY"

if [ "$MODE" = generator ]; then
    install -m 0755 "$PIPE_BINARY" "$BIN/$PIPE_BINARY" 2>/dev/null || true
    echo "install: binary -> $BIN/$PIPE_BINARY"
    mkdir -p "$STAGEDIR"
    systemctl stop "$TIMER" 2>/dev/null || true
    install -m 0644 "$SERVICE" "$SYSTEMD/$SERVICE"
    install -m 0644 "$TIMER"   "$SYSTEMD/$TIMER"
    systemctl daemon-reload
    systemctl enable --now "$TIMER"
    echo "install: timer enabled -> $TIMER"
    echo "install: run now with -> sudo systemctl start $SERVICE"
fi

rm -f "$PACKAGE" "$BINARY.sh" 2>/dev/null || true
echo "install: complete"
EOF_BODY
} > "$INSTALL/$INSTALLER"
chmod +x "$INSTALL/$INSTALLER"

# ---- package -----------------------------------------------------------------
echo "BUILD    $PACKAGE"
tar -czf "$BUILD/$PACKAGE" -C "$INSTALL" $FILES
mv "$BUILD/$PACKAGE" "$INSTALL/$PACKAGE"

# ---- transmit ----------------------------------------------------------------
if [ -n "$HOST" ]; then
    echo "TRANSMIT $PACKAGE + $INSTALLER -> $HOST"
    scp "$INSTALL/$PACKAGE" "$INSTALL/$INSTALLER" "$HOST:"
    echo "RUN      $HOST: sudo ./$INSTALLER"
    ssh "$HOST" "sudo ./$INSTALLER"
    echo "CLEANUP  $INSTALL"
    rm -rf "$INSTALL"
else
    echo "PACKAGE  $INSTALL/$PACKAGE"
    echo "         (no host — scp $PACKAGE + $INSTALLER to a server and run sudo ./$INSTALLER)"
fi
echo "bye"
