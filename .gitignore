# Test binary, built with `go test -c`
*.test

# Editor/IDE
.vscode/
.claude

# MAC OSX remove from everywhere
**/.DS_Store
**/~*

# ignore directories
_bin/
_dev/
sandbox/
install/
# ignore large downloaded corpora under testdata/, but track the small committed
# MMDB reader fixtures (built by mmdb-write; the stdlib-only root cannot synthesize
# them in-test the way the writer module does).
testdata/*
!testdata/test-*.mmdb
dat/

# build outputs and deploy target for build/cidr
build/install/
build/host

# compiled cmd binaries (built in-place by `go build ./cmd/<x>`)
/cmd/cidr/cidr
/cmd/ipfold/ipfold
/cmd/iptoasn/iptoasn
/cmd/mm-dbip/mm-dbip
/cmd/mm-geolite2-asn/mm-geolite2-asn
/cmd/mmdb-build-countries/mmdb-build-countries
/cmd/mmdb-write/mmdb-write
